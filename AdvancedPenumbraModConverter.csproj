<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.3.0.0</Version>
    <PackageProjectUrl>https://github.com/link-0402/Advanced-Penumbra-Mod-Converter</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AdvancedPenumbraModConverter</AssemblyName>
    <RootNamespace>AdvancedPenumbraModConverter</RootNamespace>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the plugin deployable as a single entry assembly. The same sources are
         also built by the standalone Core project for offline tests. -->
    <Compile Remove="AdvancedPenumbraModConverter.Core\**\*.cs" />
    <Compile Include="AdvancedPenumbraModConverter.Core\*.cs" />
    <Compile Remove="AdvancedPenumbraModConverter.Tests\**\*.cs" />
    <Compile Remove="TestData\**\*.cs" />
  </ItemGroup>
</Project>
